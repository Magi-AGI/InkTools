#pragma kernel AdvectHeat

Texture2D<float4> _Velocity;   // xy = vel, z = pressure
RWTexture2D<float> _Heat;      // ambient heat scalar
Texture2D<float> _HeatPrev;

float _DeltaTime;
float _AdvectionAmount = 0.7;
float _Diffusion = 0.02;
float _EdgeResetValue = 295.15; // Kelvin

[numthreads(8,8,1)]
void AdvectHeat(uint3 id : SV_DispatchThreadID)
{
    uint2 uv = id.xy;
    int2 size;
    _Heat.GetDimensions(size.x, size.y);
    if (uv.x >= size.x || uv.y >= size.y) return;

    // Edge reset to ambient
    if (uv.x < 2 || uv.y < 2 || uv.x >= size.x-2 || uv.y >= size.y-2)
    {
        _Heat[uv] = _EdgeResetValue;
        return;
    }

    float2 vel = _Velocity[uv].xy;
    float2 prevPos = (float2(uv) - vel * _DeltaTime);

    prevPos = clamp(prevPos, float2(1,1), float2(size.x-2, size.y-2));
    int2 p0 = int2(prevPos);
    int2 p1 = p0 + int2(1,0);
    int2 p2 = p0 + int2(0,1);
    int2 p3 = p0 + int2(1,1);
    float2 f = prevPos - float2(p0);

    float h00 = _HeatPrev[p0];
    float h10 = _HeatPrev[p1];
    float h01 = _HeatPrev[p2];
    float h11 = _HeatPrev[p3];

    float advected = lerp(lerp(h00, h10, f.x), lerp(h01, h11, f.x), f.y);

    float neighbors = _HeatPrev[p0 + int2(-1,0)] + _HeatPrev[p0 + int2(1,0)] + _HeatPrev[p0 + int2(0,-1)] + _HeatPrev[p0 + int2(0,1)];
    float diffused = advected + _Diffusion * (neighbors - 4.0 * advected);

    _Heat[uv] = lerp(_HeatPrev[uv], diffused, _AdvectionAmount);
}
