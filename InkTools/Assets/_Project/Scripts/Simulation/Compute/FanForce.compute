#pragma kernel AddFan

RWTexture2D<float4> _Velocity;
float2 _Center;   // UV (0-1)
float2 _Force;    // XY force to add
float _Radius;    // UV radius
float _Falloff;   // exponent falloff (>=1)

[numthreads(8,8,1)]
void AddFan(uint3 id : SV_DispatchThreadID)
{
    uint2 uvInt = id.xy;
    float2 uv = (float2(uvInt) + 0.5) / float2(_Velocity.GetDimensions());
    float2 d = uv - _Center;
    float dist = length(d);
    if (dist > _Radius) return;

    float t = 1.0 - saturate(dist / max(_Radius, 1e-5));
    float w = pow(t, max(_Falloff, 1.0));

    float2 v = _Velocity[uvInt].xy;
    v += _Force * w;
    _Velocity[uvInt] = float4(v, _Velocity[uvInt].z, 1);
}
