#pragma kernel Downsample

Texture2D<float4> _Source;
RWTexture2D<float4> _Dest;
int2 _SourceSize;
int2 _DestSize;

// Each dest pixel averages a block of the source.
[numthreads(8,8,1)]
void Downsample(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _DestSize.x || (int)id.y >= _DestSize.y) return;

    int2 dest = int2(id.xy);
    // Compute block in source
    float2 ratio = max(float2(_SourceSize) / max(float2(_DestSize), 1.0.xx), 1.0.xx);
    int2 blockSize = int2(ratio + 0.5);
    int2 start = dest * blockSize;
    int2 end = min(start + blockSize, _SourceSize);

    float4 sum = 0;
    int count = 0;
    for (int y = start.y; y < end.y; y++)
    {
        for (int x = start.x; x < end.x; x++)
        {
            sum += _Source[int2(x, y)];
            count++;
        }
    }
    _Dest[dest] = sum / max(count, 1);
}
